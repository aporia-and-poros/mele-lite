<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDisplayName</key>
	<string>Mele Lite</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>chat.mele.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mele</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>让 TA 知道你在「音乐」里放什么歌。</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>让 TA 知道你接下来几天有什么事（只读标题和时间）。</string>
	<key>NSCameraUsageDescription</key>
	<string>用于在聊天里直接拍照发给 TA。</string>
	<key>NSFaceIDUsageDescription</key>
	<string>打开隐私相册和上锁的抽屉时验证是你。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>首页健康小组件显示步数、距离、活动消耗、睡眠、心率；你打开「步数和睡眠」后，TA 聊天时知道你今天走了多少、昨晚睡了多久（只读）。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Mele Lite 不会往「健康」里写任何数据，只读步数、睡眠等给首页小组件看。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>连你自己在家里电脑上部署的记忆库（MCP 服务）。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>待办里「到了 / 离开某个地方时提醒」要用：手机只告诉 TA 你到了或离开了哪个存过的地方，不记你走过的路。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>拿你那边的天气，和你不在家时让 TA 知道你在哪（只在打开 App 时看，不记你走过的路）。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>按住麦克风给 TA 发语音时录音；给 TA 打电话时听你说话。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于从相册选照片发给 TA。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>给 TA 打电话时，把你正在说的话先变成字显示出来（用 iPhone 自带的语音识别，会经过苹果的识别服务）。</string>
	<key>UIAppFonts</key>
	<array>
		<string>Ballet.ttf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
